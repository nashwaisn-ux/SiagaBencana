<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Siaga.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/SiagaLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="STATUS PENANGANAN" />

        <!-- Langkah 1: Diterima -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivStep1"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/bg_circle_green"
                    android:contentDescription="Laporan diterima"
                    android:padding="3dp"
                    android:src="@drawable/ic_check"
                    app:tint="@color/white" />

                <View
                    android:id="@+id/line1"
                    android:layout_width="2dp"
                    android:layout_height="26dp"
                    android:background="@color/siaga_green" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStep1Judul"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Laporan diterima"
                    android:textColor="@color/badge_done_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWaktuDiterima"
                    style="@style/SiagaCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-" />
            </LinearLayout>
        </LinearLayout>

        <!-- Langkah 2: Verifikasi / Penanganan -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivStep2"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/bg_circle_orange"
                    android:contentDescription="Status penanganan"
                    android:padding="3dp"
                    android:src="@drawable/ic_check"
                    app:tint="@color/white" />

                <View
                    android:id="@+id/line2"
                    android:layout_width="2dp"
                    android:layout_height="26dp"
                    android:background="@color/siaga_outline" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStep2Judul"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sedang diproses"
                    android:textColor="@color/badge_high_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvKeteranganProses"
                    style="@style/SiagaCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-" />
            </LinearLayout>
        </LinearLayout>

        <!-- Langkah 3: Selesai -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivStep3"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/bg_circle_outline"
                android:contentDescription="Selesai"
                android:padding="3dp"
                android:src="@drawable/ic_check"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvStep3Judul"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Selesai"
                android:textColor="@color/siaga_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
