<?xml version="1.0" encoding="utf-8"?>
<!-- Relawan bertugas: tampilkan rowTugas. Relawan tersedia: tampilkan btnTugaskan. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Siaga.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:layout_marginBottom="10dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvInisial"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_avatar_blue"
                android:gravity="center"
                android:text="BS"
                android:textColor="@color/badge_low_text"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNama"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Budi Santoso"
                    android:textColor="@color/siaga_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvInfo"
                    style="@style/SiagaCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Evakuasi · 0812-xxxx-0123" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatus"
                style="@style/SiagaBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_high"
                android:text="Bertugas"
                android:textColor="@color/badge_high_text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowTugas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_info_gray"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_document"
                app:tint="@color/siaga_text_secondary" />

            <TextView
                android:id="@+id/tvLaporanTugas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Banjir meluap di permukiman"
                android:textColor="@color/siaga_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGanti"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ganti"
                android:textColor="@color/siaga_red"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTugaskan"
            style="@style/Widget.Siaga.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="44dp"
            android:text="Tugaskan ke laporan"
            android:textSize="12sp"
            android:visibility="gone"
            app:cornerRadius="12dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
