<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/siaga_bg"
    tools:context=".DetailLaporanActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:background="@color/siaga_thumb">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vpFoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/tvIndexFoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="40dp"
                    android:background="@drawable/bg_pill_dark"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="1 / 3 foto bukti"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-24dp"
                android:background="@drawable/bg_content_top"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvBadgeUrgensi"
                        style="@style/SiagaBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_critical"
                        android:text="Kritis"
                        android:textColor="@color/badge_critical_text" />

                    <TextView
                        android:id="@+id/tvBadgeJenis"
                        style="@style/SiagaBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_badge_low"
                        android:text="Banjir"
                        android:textColor="@color/badge_low_text" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvJudul"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Banjir meluap di permukiman"
                    android:textColor="@color/siaga_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDeskripsi"
                    style="@style/SiagaBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Air setinggi lutut masuk ke rumah warga sejak subuh. Butuh perahu karet dan dapur umum." />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Siaga.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_location"
                            app:tint="@color/siaga_red" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvKoordinat"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-0.5071, 101.4478"
                                android:textColor="@color/siaga_text"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvPelapor"
                                style="@style/SiagaCaption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Dilaporkan oleh Rina A. · 20 menit lalu" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvBukaPeta"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:gravity="center_vertical"
                            android:text="Buka peta"
                            android:textColor="@color/siaga_red"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/SiagaSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Status penanganan"
                    android:textSize="15sp" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Siaga.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Langkah 1: selesai -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="20dp"
                                android:layout_height="wrap_content"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:background="@drawable/bg_circle_green"
                                    android:importantForAccessibility="no"
                                    android:padding="3dp"
                                    android:src="@drawable/ic_check"
                                    app:tint="@color/white" />

                                <View
                                    android:layout_width="2dp"
                                    android:layout_height="22dp"
                                    android:background="@color/siaga_green" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">

                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Laporan diterima" android:textColor="@color/siaga_text" android:textSize="13sp" android:textStyle="bold" />
                                <TextView android:id="@+id/tvWaktuDiterima" style="@style/SiagaCaption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="07.12 WIB" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Langkah 2: aktif -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="20dp"
                                android:layout_height="wrap_content"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <View
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:background="@drawable/bg_circle_orange" />

                                <View
                                    android:layout_width="2dp"
                                    android:layout_height="26dp"
                                    android:background="@color/siaga_outline" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">

                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sedang diproses" android:textColor="@color/badge_high_text" android:textSize="13sp" android:textStyle="bold" />
                                <TextView android:id="@+id/tvKeteranganProses" style="@style/SiagaCaption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Relawan menuju lokasi" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Langkah 3: belum -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:background="@drawable/bg_circle_outline" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="Selesai"
                                android:textColor="@color/siaga_text_secondary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Siaga.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvInisialRelawan"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_avatar_blue"
                            android:gravity="center"
                            android:text="BS"
                            android:textColor="@color/badge_low_text"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvNamaRelawan"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Budi Santoso"
                                android:textColor="@color/siaga_text"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvInfoRelawan"
                                style="@style/SiagaCaption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Relawan ditugaskan · Tim Evakuasi" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvHubungi"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:gravity="center_vertical"
                            android:text="Hubungi"
                            android:textColor="@color/siaga_red"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_icon_btn_white"
        android:contentDescription="Kembali"
        android:elevation="4dp"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/siaga_text" />

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEdit"
            style="@style/Widget.Siaga.Button.Outline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Edit" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHapus"
            style="@style/Widget.Siaga.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Hapus" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
