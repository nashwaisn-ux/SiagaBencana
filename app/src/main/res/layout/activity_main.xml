<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".MainActivity">

    <!-- Scrollable Content -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <!-- Header Background Navy Gelap -->
            <View
                android:id="@+id/headerBackground"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:background="@drawable/bg_header_navy"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Sapaan & Nama Pengguna -->
            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selamat pagi,"
                android:textColor="#B0BEC5"
                android:textSize="13sp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rina Anggraini"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginStart="20dp"
                android:layout_marginTop="2dp"
                app:layout_constraintTop_toBottomOf="@id/tvGreeting"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Tombol Notifikasi di Kanan Atas -->
            <ImageView
                android:id="@+id/btnNotification"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_red"
                android:backgroundTint="#264665"
                android:padding="10dp"
                android:src="@android:drawable/ic_popup_reminder"
                android:layout_marginEnd="20dp"
                app:tint="@color/white"
                app:layout_constraintTop_toTopOf="@id/tvGreeting"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- GRID STATISTIK (2x2 Card) -->
            <!-- Card 1: Laporan baru -->
            <LinearLayout
                android:id="@+id/cardStat1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/tvUsername"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/cardStat2">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Laporan baru"
                    android:textColor="#646E78"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12"
                    android:textColor="#C62828"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Card 2: Sedang ditangani -->
            <LinearLayout
                android:id="@+id/cardStat2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/tvUsername"
                app:layout_constraintStart_toEndOf="@id/cardStat1"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sedang ditangani"
                    android:textColor="#646E78"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7"
                    android:textColor="#C62828"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Card 3: Selesai -->
            <LinearLayout
                android:id="@+id/cardStat3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@id/cardStat1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/cardStat4">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selesai"
                    android:textColor="#646E78"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="38"
                    android:textColor="#2E7D32"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Card 4: Relawan aktif -->
            <LinearLayout
                android:id="@+id/cardStat4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@id/cardStat2"
                app:layout_constraintStart_toEndOf="@id/cardStat3"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Relawan aktif"
                    android:textColor="#646E78"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24"
                    android:textColor="#1565C0"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- MENU AKSES CEPAT (4 Tombol Baris) -->
            <LinearLayout
                android:id="@+id/layoutQuickMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="4"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/cardStat3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Menu 1: Lapor -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_circle_red"
                        android:padding="14dp"
                        android:src="@android:drawable/ic_input_add"
                        app:tint="@color/white" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lapor"
                        android:textColor="#17324D"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- Menu 2: Peta Siaga -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_card"
                        android:padding="14dp"
                        android:src="@android:drawable/ic_menu_mapmode"
                        app:tint="#C62828" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Peta Siaga"
                        android:textColor="#17324D"
                        android:textSize="12sp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- Menu 3: Relawan -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_card"
                        android:padding="14dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        app:tint="#C62828" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Relawan"
                        android:textColor="#17324D"
                        android:textSize="12sp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- Menu 4: Riwayat -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_card"
                        android:padding="14dp"
                        android:src="@android:drawable/ic_menu_recent_history"
                        app:tint="#C62828" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Riwayat"
                        android:textColor="#17324D"
                        android:textSize="12sp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- BANNER PERINGATAN RADIUS SIAGA -->
            <LinearLayout
                android:id="@+id/bannerAlert"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_banner_alert"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/layoutQuickMenu"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_dialog_alert"
                    app:tint="#C62828"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Siaga banjir radius 3 km"
                        android:textColor="#C62828"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 laporan kritis dekat lokasi Anda. Buka peta siaga."
                        android:textColor="#5D4037"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- SECTION HEADER: Laporan Terbaru -->
            <TextView
                android:id="@+id/tvSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Laporan terbaru"
                android:textColor="#17324D"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginStart="20dp"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/bannerAlert"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvSeeAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lihat semua"
                android:textColor="#C62828"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginEnd="20dp"
                app:layout_constraintBottom_toBottomOf="@id/tvSectionTitle"
                app:layout_constraintTop_toTopOf="@id/tvSectionTitle"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- KARTU LAPORAN 1 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardReport1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@id/tvSectionTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Placeholder Gambar Thumbnail -->
                <View
                    android:id="@+id/imgThumbnail1"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="#E0E0E0"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tvReportTitle1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Banjir meluap di permukiman"
                    android:textColor="#17324D"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/imgThumbnail1"
                    app:layout_constraintEnd_toStartOf="@id/badgeKritis" />

                <TextView
                    android:id="@+id/tvReportSub1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Banjir • 20 menit lalu"
                    android:textColor="#78909C"
                    android:textSize="12sp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="4dp"
                    app:layout_constraintTop_toBottomOf="@id/tvReportTitle1"
                    app:layout_constraintStart_toEndOf="@id/imgThumbnail1"
                    app:layout_constraintEnd_toStartOf="@id/badgeKritis" />

                <!-- Badge Kritis -->
                <TextView
                    android:id="@+id/badgeKritis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kritis"
                    android:textColor="#C62828"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge_critical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- KARTU LAPORAN 2 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardReport2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@id/cardReport1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Placeholder Gambar Thumbnail -->
                <View
                    android:id="@+id/imgThumbnail2"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="#E0E0E0"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tvReportTitle2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Kebakaran lahan kosong"
                    android:textColor="#17324D"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/imgThumbnail2"
                    app:layout_constraintEnd_toStartOf="@id/badgeTinggi" />

                <TextView
                    android:id="@+id/tvReportSub2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Kebakaran • 1 jam lalu"
                    android:textColor="#78909C"
                    android:textSize="12sp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="4dp"
                    app:layout_constraintTop_toBottomOf="@id/tvReportTitle2"
                    app:layout_constraintStart_toEndOf="@id/imgThumbnail2"
                    app:layout_constraintEnd_toStartOf="@id/badgeTinggi" />

                <!-- Badge Tinggi -->
                <TextView
                    android:id="@+id/badgeTinggi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tinggi"
                    android:textColor="#E65100"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_badge_high"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar di Bagian Bawah -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>