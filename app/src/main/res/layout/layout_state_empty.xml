<?xml version="1.0" encoding="utf-8"?>
<!-- State data kosong -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="40dp"
    android:paddingEnd="40dp">

    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_circle_blue_soft">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_document"
            app:tint="@color/badge_low_text" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvEmptyTitle"
        style="@style/SiagaSection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Belum ada data"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvEmptyDesc"
        style="@style/SiagaBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Tidak ada data yang cocok. Tambahkan data baru atau ubah filter pencarian." />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEmptyAksi"
        style="@style/Widget.Siaga.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:text="Buat laporan" />
</LinearLayout>
