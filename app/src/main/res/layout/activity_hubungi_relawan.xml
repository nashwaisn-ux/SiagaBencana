<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8">

    <!-- Header Relawan -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarRelawan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:minHeight="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back_24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginEnd="12dp">

            <!-- Avatar / Badge Relawan -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="42dp"
                android:layout_height="42dp"
                app:cardBackgroundColor="#E6F4F1"
                app:cardCornerRadius="21dp"
                app:cardElevation="0dp"
                app:strokeColor="#146C60"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/tvInisialRelawan"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="RL"
                    android:textColor="#146C60"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Nama & Status Ketersediaan -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNamaRelawan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Raka • Relawan"
                    android:textColor="#1A202C"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/viewStatusDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_status_dot_active" />

                    <TextView
                        android:id="@+id/tvStatusRelawan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Siap Merespons • Posko Utara"
                        android:textColor="#146C60"
                        android:textSize="12sp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>
            </LinearLayout>

            <!-- Tombol Bagikan Lokasi -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKirimLokasi"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="10dp"
                android:text="Lokasi"
                android:textAllCaps="false"
                android:textColor="#B91C1C"
                android:textSize="12sp"
                app:cornerRadius="18dp"
                app:strokeColor="#FCA5A5"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Banner Panduan Singkat Koordinasi -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardInfoKoordinasi"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="#FFFBEB"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarRelawan"
        app:strokeColor="#FCD34D"
        app:strokeWidth="1dp">

        <TextView
            android:id="@+id/tvInfoKoordinasi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="Sertakan patokan jalan atau titik lokasi agar relawan dapat merespons lebih cepat."
            android:textColor="#92400E"
            android:textSize="12sp"
            tools:ignore="HardcodedText" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Daftar Bubble Chat -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/hsvQuickReply"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardInfoKoordinasi"
        tools:listitem="@layout/item_chat_relawan" />

    <!-- Quick Reply Chips -->
    <HorizontalScrollView
        android:id="@+id/hsvQuickReply"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/layoutInputChat"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupQuickReply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipEvakuasi"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Butuh evakuasi segera"
                android:textColor="#991B1B"
                android:textSize="12sp"
                app:chipBackgroundColor="#FEF2F2"
                app:chipStrokeColor="#FECACA"
                app:chipStrokeWidth="1dp"
                tools:ignore="HardcodedText" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLokasiAman"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Posisi di titik aman"
                android:textColor="#146C60"
                android:textSize="12sp"
                app:chipBackgroundColor="#ECFDF5"
                app:chipStrokeColor="#A7F3D0"
                app:chipStrokeWidth="1dp"
                tools:ignore="HardcodedText" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLogistik"
                style="@style/Widget.MaterialComponents.Chip.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Butuh air &amp; P3K"
                android:textColor="#1E3A8A"
                android:textSize="12sp"
                app:chipBackgroundColor="#EFF6FF"
                app:chipStrokeColor="#BFDBFE"
                app:chipStrokeWidth="1dp"
                tools:ignore="HardcodedText" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Area Input Pesan -->
    <LinearLayout
        android:id="@+id/layoutInputChat"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cardBackgroundColor="#F4F6F8"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="#CBD5E1"
            app:strokeWidth="1dp">

            <EditText
                android:id="@+id/etPesan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="Ketik pesan ke relawan..."
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:minHeight="42dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:textColor="#1A202C"
                android:textColorHint="#64748B"
                android:textSize="14sp"
                tools:ignore="HardcodedText" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnKirim"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:contentDescription="Kirim pesan"
            app:backgroundTint="#146C60"
            app:fabCustomSize="44dp"
            app:srcCompat="@drawable/ic_send_24"
            app:tint="#FFFFFF"
            tools:ignore="HardcodedText" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>