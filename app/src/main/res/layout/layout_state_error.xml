<?xml version="1.0" encoding="utf-8"?>
<!-- State gagal jaringan / server -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/bannerOffline"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="top"
        android:layout_margin="16dp"
        android:background="@drawable/bg_banner_offline"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_wifi_off"
            app:tint="@color/siaga_red_stroke" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Tidak ada koneksi internet"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp">

        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/bg_circle_red_soft">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_wifi_off"
                app:tint="@color/siaga_red" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvErrorTitle"
            style="@style/SiagaSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Gagal terhubung ke server"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvErrorDesc"
            style="@style/SiagaBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Pastikan ponsel dan server Laragon berada di jaringan Wi-Fi yang sama, lalu coba lagi." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCobaLagi"
            style="@style/Widget.Siaga.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="Coba lagi" />
    </LinearLayout>
</FrameLayout>
