<?xml version="1.0" encoding="utf-8"?>
<!-- Layout untuk BottomSheetDialogFragment konfirmasi hapus massal.
     Aktifkan btnYaHapus hanya jika etKonfirmasi == "HAPUS" dan role == petugas. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_top"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_handle" />

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_circle_red_soft">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_trash"
            app:tint="@color/siaga_red" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvJudulHapus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Hapus 3 laporan?"
        android:textColor="@color/siaga_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        style="@style/SiagaBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Laporan beserta foto buktinya akan dihapus permanen dan tidak bisa dikembalikan. Tindakan ini tercatat di riwayat." />

    <TextView
        android:id="@+id/tvDaftarHapus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_info_gray"
        android:lineSpacingExtra="4dp"
        android:padding="12dp"
        android:text="• Banjir meluap di permukiman\n• Kebakaran lahan kosong\n• Tanah longsor tutup jalan"
        android:textColor="@color/siaga_text"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_info_blue"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_shield"
            app:tint="@color/badge_low_text" />

        <TextView
            android:id="@+id/tvOtorisasi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:lineSpacingExtra="2dp"
            android:text="Otorisasi: hanya role Petugas yang boleh menghapus massal. Anda masuk sebagai Petugas BPBD."
            android:textColor="@color/badge_low_text"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilKonfirmasi"
        style="@style/Widget.Siaga.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="Ketik HAPUS untuk konfirmasi">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etKonfirmasi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapCharacters"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBatal"
            style="@style/Widget.Siaga.Button.Outline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Batal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnYaHapus"
            style="@style/Widget.Siaga.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:enabled="false"
            android:text="Ya, hapus" />
    </LinearLayout>
</LinearLayout>
