<?xml version="1.0" encoding="utf-8"?>
<!-- Item RecyclerView laporan. Mode pilih massal: tampilkan cbPilih dan ubah card.isChecked.
     Badge: ganti background ke bg_badge_critical / high / medium / low / done dan warna teksnya. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardLaporan"
    style="@style/Widget.Siaga.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:layout_marginBottom="8dp"
    android:checkable="true"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/card_bg_color"
    app:cardElevation="0dp"
    app:checkedIcon="@null"
    app:strokeColor="@color/card_stroke_color"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:padding="10dp">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbPilih"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:visibility="gone" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgThumb"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_thumb"
            android:contentDescription="Foto bukti laporan"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/SiagaRoundedImage" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvJudul"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/siaga_text"
                android:textSize="14sp"
                android:textStyle="bold"
                android:text="Banjir meluap di permukiman" />

            <TextView
                android:id="@+id/tvMeta"
                style="@style/SiagaCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Banjir · 20 menit lalu" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBadge"
            style="@style/SiagaBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_critical"
            android:text="Kritis"
            android:textColor="@color/badge_critical_text" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
