<?xml version="1.0" encoding="utf-8"?>
<!-- Ikon: dibuat (ic_add + bg_icon_box_green), relawan (ic_group + blue), diubah (ic_edit + orange),
     dihapus (ic_trash + red), foto (ic_camera + blue), selesai (ic_check + green). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Siaga.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <FrameLayout
            android:id="@+id/boxIkon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_icon_box_green">

            <ImageView
                android:id="@+id/imgIkon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_add"
                app:tint="@color/badge_done_text" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAksi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Laporan dibuat"
                android:textColor="@color/siaga_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvKeterangan"
                style="@style/SiagaCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Banjir meluap di permukiman" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvJam"
            style="@style/SiagaCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="07.12"
            android:textSize="11sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
