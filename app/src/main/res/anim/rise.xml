<?xml version="1.0" encoding="utf-8"?>
<!-- Splash 2: kartu naik. Beri startOffset 0 / 500 / 1000 per kartu di Kotlin. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:fillAfter="true">
    <translate android:duration="900" android:fromYDelta="40%" android:toYDelta="0" />
    <scale
        android:duration="900"
        android:fromXScale="0.7"
        android:fromYScale="0.7"
        android:toXScale="1"
        android:toYScale="1"
        android:pivotX="50%"
        android:pivotY="50%" />
    <alpha android:duration="900" android:fromAlpha="0" android:toAlpha="1" />
</set>
